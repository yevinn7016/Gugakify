# Cloudinary (config.py에서 사용)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# MySQL 연결 정보 (현재 database.py에 하드코딩되어 있음 - 필요 시 이 값으로 교체해서 사용)
DATABASE_URL=mysql+pymysql://root:root@localhost/gugakify

# AI MV 변환 서버 (현재 routers/mv_conversion.py, routers/mv_process.py에 하드코딩되어 있음)
AI_MV_SERVER=https://your-ai-mv-server.example.com
MV_API_KEY=your-mv-api-key

# AI 결과 수신 인증 토큰 (현재 routers/arrangements.py에 하드코딩되어 있음)
BACKEND_TOKEN=your-backend-token
