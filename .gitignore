# Python
venv/
.venv/
__pycache__/
*.pyc
*.pyo

# Python test / lint / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment variables (never commit real values)
.env
.env.local
.env.*.local
*.env
!.env.example

# Firebase Admin service account keys (server-side secret, never commit)
firebase_key.json
google.json
serviceAccountKey.json
*-firebase-adminsdk-*.json
firebase_options_private.dart

# Firebase client config
# 이 저장소는 google-services.json을 커밋하지 않는 방식(개발자별 로컬 생성)을 이미 사용 중 -> GoogleService-Info.plist도 동일하게 취급
google-services.json
GoogleService-Info.plist

# Certificates / private keys
*.pem
*.key
*.p12
*.pfx

# Miscellaneous
*.class
*.log
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/
gugakify.iml

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# iOS
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Pods/

